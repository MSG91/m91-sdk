{
  "name": "@msg91comm/m91",
  "version": "1.2.0",
  "description": "Critical alerting and human-in-the-loop approval for AI agents and on-call systems",
  "type": "module",
  "license": "MIT",
  "author": "MSG91",
  "keywords": [
    "alerting",
    "on-call",
    "paging",
    "human-in-the-loop",
    "agent",
    "approval",
    "escalation",
    "langchain",
    "langgraph",
    "langchainjs",
    "vercel-ai",
    "ai-sdk",
    "openai-agents",
    "claude-agent-sdk",
    "google-adk",
    "mastra",
    "tool-approval"
  ],
  "homepage": "https://m91-api.msg91.com/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MSG91/m91-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/MSG91/m91-sdk/issues"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./integrations/langchain": {
      "types": "./dist/src/integrations/langchain.d.ts",
      "default": "./dist/src/integrations/langchain.js"
    },
    "./integrations/langgraph": {
      "types": "./dist/src/integrations/langgraph.d.ts",
      "default": "./dist/src/integrations/langgraph.js"
    },
    "./integrations/vercel-ai": {
      "types": "./dist/src/integrations/vercel-ai.d.ts",
      "default": "./dist/src/integrations/vercel-ai.js"
    },
    "./integrations/openai-agents": {
      "types": "./dist/src/integrations/openai-agents.d.ts",
      "default": "./dist/src/integrations/openai-agents.js"
    },
    "./integrations/claude-agent-sdk": {
      "types": "./dist/src/integrations/claude-agent-sdk.d.ts",
      "default": "./dist/src/integrations/claude-agent-sdk.js"
    },
    "./integrations/google-adk": {
      "types": "./dist/src/integrations/google-adk.d.ts",
      "default": "./dist/src/integrations/google-adk.js"
    },
    "./integrations/mastra": {
      "types": "./dist/src/integrations/mastra.d.ts",
      "default": "./dist/src/integrations/mastra.js"
    }
  },
  "files": [
    "dist/src",
    "src",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test dist/tests/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.308",
    "@google/adk": "^2.3.0",
    "@langchain/core": "^1.2.20",
    "@mastra/core": "^1.79.0",
    "@openai/agents": "^0.21.0",
    "@types/node": "^22.0.0",
    "ai": "^7.0.148",
    "deepagents": "^1.15.1",
    "langchain": "^1.5.18",
    "typescript": "^5.4.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": ">=0.3.0",
    "@google/adk": ">=2.3.0",
    "@langchain/core": ">=0.2.0",
    "@langchain/langgraph": ">=0.2.0",
    "@mastra/core": ">=1.79.0",
    "@openai/agents": ">=0.21.0",
    "ai": ">=5.0.0",
    "zod": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "@google/adk": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    },
    "@langchain/langgraph": {
      "optional": true
    },
    "@mastra/core": {
      "optional": true
    },
    "@openai/agents": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  }
}
